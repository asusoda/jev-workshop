{
  "name": "jev-workshop",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node --import tsx src/server.ts",
    "triage": "node --import tsx --env-file=.env src/workshop.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx --env-file=.env src/index.ts",
    "noul": "tsx --env-file=.env src/examples/noul.ts",
    "choice": "tsx --env-file=.env src/examples/choice.ts",
    "score": "tsx --env-file=.env src/examples/score.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
